# --- App ---
APP_NAME=deribit-client
APP_ENV=local
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Logging ---
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=deribit
POSTGRES_PASSWORD=deribit
POSTGRES_DB=deribit

# --- Redis (Celery broker/backend) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Celery ---
CELERY_FETCH_INTERVAL_SECONDS=60

# --- Deribit ---
DERIBIT_BASE_URL=https://www.deribit.com/api/v2
DERIBIT_REQUEST_TIMEOUT=10
